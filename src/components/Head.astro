---
// Starlight's head, and the page's Markdown twin announced in it: a model that lands on a page
// finds the same content as Markdown without guessing the address. linkcheck fails one that
// does not resolve.

import { getCollection } from 'astro:content';
import { GA_ID } from 'astro:env/server';
import Default from '@astrojs/starlight/components/Head.astro';
import mono400 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import mono600 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-600-normal.woff2?url';
// The faces the first screen sets, fetched with the page: found late, through the stylesheet, a
// face swaps in after the first paint and the notice and the hero move with it (a layout shift of
// 0.23 on a phone, measured).
import sans400 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import sans600 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url';
import { graph } from '../lib/jsonld';
import { twinPath } from '../lib/twin';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// The link preview a chat shows, by its absolute address: the page's card (src/pages/cards/), or
// for the landing page and the 404, which have none, the landing page's (src/pages/og.png.ts).
const route = Astro.locals.starlightRoute;
const { id } = route;
const hasCard = !['', 'index', '404'].includes(id);
const image = new URL(`${base}${hasCard ? `/cards/${id.replace(/\/$/, '')}.png` : '/og.png'}`, Astro.site).href;

// What a search result and a tab show: the page's metaTitle, or its title, and the brand once.
// Starlight's own is "<title> | Spinbox", which made the landing page "Spinbox | Spinbox" and
// most others under 30 characters, too little for a result to say what the page is.
const { title, metaTitle } = route.entry.data as { title: string; metaTitle?: string };
const named = metaTitle ?? title;
const full = id === '404' ? 'Page not found | Spinbox' : named.includes('Spinbox') ? named : `${named} | Spinbox`;
if (id !== '404' && (full.length < 30 || full.length > 65)) {
	throw new Error(`${id}: its <title> "${full}" is ${full.length} characters; give it a metaTitle that makes it 30 to 65`);
}
for (const tag of route.head) if (tag.tag === 'title') tag.content = full;

const ids = new Set((await getCollection('docs')).map((d) => d.id));
const home = new URL(`${base}/`, Astro.site).href;
const url = new URL(Astro.url.pathname, Astro.site).href;
const jsonld = graph({ id, title, description: route.entry.data.description ?? '', lastUpdated: route.lastUpdated, image }, url, home, ids);
---

<Default />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:image" content={image} />
<link rel="alternate" type="text/markdown" href={`${base}${twinPath(id)}`} />
<script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
{GA_ID && <script is:inline async src={`${base}/ga.js`} data-id={GA_ID} />}
{[sans400, sans600, mono400, mono600].map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
