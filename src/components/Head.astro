---
// Starlight's head, and the page's Markdown twin announced in it: a model that lands on a page
// finds the same content as Markdown without guessing the address. linkcheck fails one that
// does not resolve.
import Default from '@astrojs/starlight/components/Head.astro';
import { twinPath } from '../lib/twin';
// The faces the first screen sets, fetched with the page: found late, through the stylesheet, a
// face swaps in after the first paint and the notice and the hero move with it (a layout shift of
// 0.23 on a phone, measured).
import sans400 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import sans600 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url';
import mono400 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import mono600 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-600-normal.woff2?url';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Default />
<link rel="alternate" type="text/markdown" href={`${base}${twinPath(Astro.locals.starlightRoute.id)}`} />
{[sans400, sans600, mono400, mono600].map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
