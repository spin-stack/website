---
// Starlight's page title, with what a reader taking the page elsewhere wants beside it: the
// page's Markdown twin copied, or opened. Nothing names an assistant; the twin is the page.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { twinPath } from '../lib/twin';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const twin = `${base}${twinPath(Astro.locals.starlightRoute.id)}`;
---

<Default />
<div class="page-actions" data-pagefind-ignore>
	<button type="button" class="copy" data-twin={twin}>Copy as Markdown</button>
	<a href={twin}>View Markdown</a>
</div>

<script>
	for (const b of document.querySelectorAll<HTMLButtonElement>('.page-actions .copy')) {
		b.addEventListener('click', async () => {
			const label = b.textContent;
			try {
				const md = await (await fetch(b.dataset.twin!)).text();
				await navigator.clipboard.writeText(md);
				b.textContent = 'Copied';
			} catch {
				b.textContent = 'Could not copy';
			}
			setTimeout(() => (b.textContent = label), 1600);
		});
	}
</script>

<style>
	.page-actions {
		display: flex;
		gap: 0.5rem;
		margin-top: 0.75rem;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
	}
	.page-actions > * {
		display: inline-flex;
		align-items: center;
		min-height: 2rem;
		padding: 0 0.75rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: var(--spin-radius-sm);
		background: transparent;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		cursor: pointer;
		font: inherit;
	}
	.page-actions > *:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	@media (pointer: coarse) {
		.page-actions > * {
			min-height: 2.75rem;
		}
	}
</style>
