---
// The feature board in four numbers, as they are, and the sentence that
// says where they come from (src/lib/reference.ts). Its Markdown twin is that sentence.
import reference from '../data/reference.json';
import StatusCounts from './StatusCounts.astro';

const { counts } = reference;
const stats = [
	{ n: counts.built, label: 'features built', note: 'each with a test or a command that proves it' },
	// Each names a test that is there and not quarantined; until spin checks that a lane runs it
	// and it does not skip, the tile says "with", not "proved".
	{ n: counts.endToEnd, label: 'with an end-to-end test', note: 'by tests against a real runner' },
	{ n: counts.limits, label: 'limits written down', note: 'what it does not do, held to the code' },
	{ n: counts.notBuilt, label: 'not built yet', note: 'said, not hidden' },
];
---

<div class="stats not-content">
	{
		stats.map((s) => (
			<div class="stat">
				<span class="n">
					{s.n}
				</span>
				<span class="label">{s.label}</span>
				<span class="note">{s.note}</span>
			</div>
		))
	}
</div>
<StatusCounts />


<style>
	.stats {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1px;
		margin-block: 1.5rem 1rem;
		border-radius: var(--spin-radius);
		overflow: hidden;
		background: var(--sl-color-hairline-light);
		border: 1px solid var(--sl-color-hairline-light);
	}
	@media (min-width: 50rem) {
		.stats {
			grid-template-columns: repeat(4, 1fr);
		}
	}
	.stat {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 1.5rem 1.4rem;
		background: var(--sl-color-black);
	}
	.n {
		font-family: var(--sl-font-mono);
		font-size: clamp(2.4rem, 1.5rem + 2.5vw, 3.6rem);
		font-weight: 600;
		line-height: 1;
		letter-spacing: var(--spin-heading-tracking);
		font-variant-numeric: tabular-nums;
		color: var(--spin-accent-text);
	}
	.label {
		color: var(--sl-color-white);
		font-weight: 600;
	}
	.note {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
</style>
