---
// The feature board in four numbers, counted up as they come into view, and the sentence that
// says where they come from (src/lib/reference.ts). Its Markdown twin is that sentence.
import board from '../data/features.json';
import reference from '../data/reference.json';
import StatusCounts from './StatusCounts.astro';

const { counts } = reference;
const e2e = board.filter((r) => r.state === 'built' && r.proof.startsWith('e2e:')).length;
const stats = [
	{ n: counts.built, label: 'features built', note: 'each with a test or a command that proves it' },
	{ n: e2e, label: 'proved end to end', note: 'by tests against a real runner' },
	{ n: counts.limits, label: 'limits written down', note: 'what it does not do, held to the code' },
	{ n: counts.notBuilt, label: 'not built yet', note: 'said, not hidden' },
];
---

<div class="stats not-content" data-stats>
	{
		stats.map((s) => (
			<div class="stat">
				<span class="n" data-n={s.n}>
					{s.n}
				</span>
				<span class="label">{s.label}</span>
				<span class="note">{s.note}</span>
			</div>
		))
	}
</div>
<StatusCounts />

<script>
	const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
	for (const root of document.querySelectorAll<HTMLElement>('[data-stats]')) {
		if (still) continue;
		const nums = [...root.querySelectorAll<HTMLElement>('[data-n]')];
		nums.forEach((el) => (el.textContent = '0'));
		const count = new IntersectionObserver(
			(entries) => {
				if (!entries.some((e) => e.isIntersecting)) return;
				count.disconnect();
				const t0 = performance.now();
				const tick = (t: number) => {
					const p = Math.min((t - t0) / 1400, 1);
					const ease = 1 - Math.pow(1 - p, 3);
					nums.forEach((el) => (el.textContent = String(Math.round(Number(el.dataset.n) * ease))));
					if (p < 1) requestAnimationFrame(tick);
				};
				requestAnimationFrame(tick);
			},
			{ threshold: 0.5 },
		);
		count.observe(root);
	}
</script>

<style>
	.stats {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1px;
		margin-block: 1.5rem 1rem;
		border-radius: 18px;
		overflow: hidden;
		background: var(--sl-color-hairline-light);
		border: 1px solid var(--sl-color-hairline-light);
	}
	@media (min-width: 50rem) {
		.stats {
			grid-template-columns: repeat(4, 1fr);
		}
	}
	.stat {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 1.5rem 1.4rem;
		background: var(--sl-color-black);
	}
	.n {
		font-family: var(--sl-font-mono);
		font-size: clamp(2.4rem, 1.5rem + 2.5vw, 3.6rem);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.04em;
		font-variant-numeric: tabular-nums;
		background: linear-gradient(120deg, var(--spin-brand-cyan), var(--spin-brand-blue));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.label {
		color: var(--sl-color-white);
		font-weight: 600;
	}
	.note {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
</style>
