---
// A diagram the source repositories draw (tools/refgen copies them into src/assets/diagrams):
// shown on a light panel in both themes, as drawn, and zoomed in place by starlight-image-zoom,
// whose markup this writes: the plugin finds images in Markdown, and this one is a component's. Its words are
// in src/data/figures.json, which the page's Markdown twin carries instead of the picture.
import figures from '../data/figures.json';

interface Props {
	name: keyof typeof figures;
	caption: string;
}
const { name, caption } = Astro.props;
const files = import.meta.glob<string>('../assets/diagrams/*.svg', { query: '?url', import: 'default', eager: true });
const url = files[`../assets/diagrams/${name}.svg`];
if (!url) throw new Error(`Figure: no diagram ${name} in src/assets/diagrams`);
const { source, width } = figures[name];
// The size refgen chose for it (tools/refgen/diagrams.go): a wide one scrolls rather than
// shrinking its words into a smudge, and 0 fits the column.
const style = width ? `width: max(100%, ${width}px)` : 'width: 100%';
---

<figure class="spin-figure">
	<div class="frame">
		<starlight-image-zoom-zoomable>
			<img src={url} alt={caption} loading="lazy" {style} />
			<button aria-label={`Zoom image: ${caption}`} class="starlight-image-zoom-control">
				<svg aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><use href="#starlight-image-zoom-icon-zoom"></use></svg>
			</button>
		</starlight-image-zoom-zoomable>
	</div>
	<figcaption>{caption} <a href={source}>Its source</a>.</figcaption>
</figure>

<style>
	.spin-figure {
		margin: 1.5rem 0;
	}
	.spin-figure > .frame {
		display: block;
		background: #fff;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: var(--spin-radius);
		padding: 1rem;
		overflow-x: auto;
	}
	.spin-figure img {
		display: block;
		max-width: none;
		height: auto;
	}
	figcaption {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		margin-top: 0.5rem;
	}
</style>
