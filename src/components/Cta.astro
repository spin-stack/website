---
// The landing page's last word: where to go next, on the navy. Its Markdown twin is
// the title and the links.
import { LinkButton } from '@astrojs/starlight/components';

interface Props {
	title: string;
	links: { text: string; href: string; variant?: 'primary' | 'secondary' | 'minimal' }[];
}
const { title, links } = Astro.props;
---

<section class="cta not-content spin-dark">
	<h2>{title}</h2>
	<p><slot /></p>
	<div class="links">
		{
			links.map(({ text, href, variant = 'secondary' }) => (
				<LinkButton href={href} variant={variant} icon={variant === 'primary' ? 'right-arrow' : undefined}>
					{text}
				</LinkButton>
			))
		}
	</div>
</section>

<style>
	.cta {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		margin-block: 4rem 1rem;
		padding: clamp(2.5rem, 2rem + 3vw, 4.5rem) clamp(1.5rem, 1rem + 3vw, 4rem);
		border-radius: var(--spin-radius);
		background: var(--spin-page);
		color: var(--spin-text);
		text-align: center;
		border: 1px solid var(--spin-border);
	}
	h2 {
		margin: 0 auto;
		max-width: 22ch;
		font-family: var(--sl-font-mono);
		font-size: clamp(1.8rem, 1.2rem + 2.4vw, 3rem);
		line-height: 1.1;
		letter-spacing: var(--spin-heading-tracking);
		color: var(--spin-brand-frost);
	}
	p {
		margin: 1rem auto 2rem;
		max-width: 40rem;
		color: var(--spin-text);
		font-size: var(--sl-text-lg);
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
	}
	.links :global(.sl-link-button.secondary) {
		color: var(--spin-brand-frost);
		border-color: var(--spin-border-strong);
	}
	.links :global(.sl-link-button.primary) {
		background: var(--spin-brand-frost);
		border-color: var(--spin-brand-frost);
		color: var(--spin-page);
	}
</style>
