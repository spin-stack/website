---
// Starlight's footer, with where the page comes from: the release an installation runs and the
// tree the reference is generated from on every page, the source a generated page is written
// from at the commit it was written at, and the page's Markdown twin.
import Default from '@astrojs/starlight/components/Footer.astro';
import reference from '../data/reference.json';
import { generatedFrom } from '../lib/reference';
import { twinPath } from '../lib/twin';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { id, entry } = Astro.locals.starlightRoute;
const source = (entry.data as { source?: string }).source;
const commits: Record<string, string> = {
	spin: reference.spin.commit,
	'spin-terraform-aws': reference.terraform.commit,
};
let generated: { href: string; repo: string; path: string; commit: string } | undefined;
if (source) {
	const [repo, path] = source.split(/:(.*)/s);
	const commit = commits[repo];
	if (!commit) throw new Error(`${id}: source ${source} names no repository the site documents`);
	generated = { href: `https://github.com/spin-stack/${repo}/blob/${commit}/${path}`, repo, path, commit };
}
---

<div class="provenance" data-pagefind-ignore>
	{
		generated && (
			<p>
				Generated by <code>task reference</code> from <a href={generated.href}>{generated.repo}/{generated.path}</a> at{' '}
				<code>{generated.commit.slice(0, 9)}</code>.
			</p>
		)
	}
	<p>
		Installations run Spinbox <code>{reference.spin.installs}</code>; the reference is generated from{' '}
		<Fragment set:html={generatedFrom.replace(/`([^`]+)`/g, '<code>$1</code>')} />.{' '}
		<a href={`${base}${twinPath(id)}`}>This page as Markdown</a>, for a model or a terminal.
	</p>
</div>
<Default />

<style>
	.provenance {
		margin-top: 3rem;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.provenance p + p {
		margin-top: 0.25rem;
	}
</style>
