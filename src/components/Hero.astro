---
// The landing page's hero: Starlight's, with the project's name above the title and, beside it, a
// terminal where a workspace is broken and brought back (Undo.astro). The title's second sentence - what Spinbox does, after what it
// is - is in the accent's text colour: one colour, flat, as the console sets what matters.
import { LinkButton } from '@astrojs/starlight/components';
import Undo from './Undo.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const cut = title.indexOf('. ');
const lead = cut < 0 ? title : title.slice(0, cut + 1);
const rest = cut < 0 ? '' : title.slice(cut + 2);
// A command in the title, between backticks, is set in the mono face.
const code = (s: string) => s.split('`').map((part, i) => (i % 2 ? `<code>${part}</code>` : part)).join('');
---

<div class="hero">
	<div class="backdrop" aria-hidden="true"></div>
	<div class="copy">
		<p class="eyebrow"><span class="dot"></span>spin-stack · workspaces you own</p>
		<h1 id="_top" data-page-title><Fragment set:html={code(lead)} /> {rest && <span class="hl" set:html={code(rest)} />}</h1>
		{tagline && <p class="tagline" set:html={tagline} />}
		<div class="actions">
			{
				actions.map(({ link: href, text, variant, icon }) => (
					<LinkButton {href} {variant} icon={icon?.name}>
						{text}
					</LinkButton>
				))
			}
		</div>
	</div>
	<div class="art"><Undo /></div>
</div>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		display: grid;
		gap: 2rem;
		align-items: center;
		padding-block: 2rem 1rem;
	}
	/* A grid of dots behind the hero, fading out towards the edges: a drawing board, not a glow. */
	.backdrop {
		position: absolute;
		inset: -10rem calc(50% - 50vw) -6rem;
		z-index: -1;
		pointer-events: none;
		background-image: radial-gradient(color-mix(in srgb, var(--sl-color-gray-3) 38%, transparent) 1px, transparent 1.5px);
		background-size: 22px 22px;
		mask-image: radial-gradient(60% 60% at 60% 45%, #000 20%, transparent 75%);
	}
	.copy {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}
	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--spin-label);
	}
	.dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--spin-label);
	}
	h1 {
		font-family: var(--spin-font-display);
		font-size: var(--spin-text-display);
		text-wrap: balance;
		line-height: 1.08;
		letter-spacing: var(--spin-display-tracking);
		word-spacing: -0.12em;
		font-weight: 600;
		color: var(--sl-color-white);
		margin: 0;
	}
	/* The second sentence starts its own line: what Spinbox does, under what it is. */
	.hl {
		display: block;
		color: var(--spin-accent-text);
	}
	h1 :global(code) {
		font: inherit;
		background: none;
		padding: 0;
		white-space: nowrap;
	}
	.tagline {
		font-size: var(--sl-text-lg);
		color: var(--sl-color-gray-2);
		max-width: 38rem;
		margin: 0;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.5rem;
		align-items: center;
	}
	/* The disk is the hero's second half, the width of the page under the words: a thing to work,
	   not a picture beside them. */
	.art {
		min-width: 0;
	}
	@media (min-width: 64rem) {
		.hero {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
			gap: 3.5rem;
			padding-block: 4rem 3rem;
		}
	}
	@media (prefers-reduced-motion: no-preference) {
		.copy > * {
			animation: hero-rise var(--spin-duration-draw) var(--spin-ease) both;
		}
		.copy > :nth-child(2) {
			animation-delay: 80ms;
		}
		.copy > :nth-child(3) {
			animation-delay: 160ms;
		}
		.copy > :nth-child(4) {
			animation-delay: 240ms;
		}
		@keyframes hero-rise {
			from {
				opacity: 0;
				transform: translateY(14px);
			}
		}
	}
</style>
