---
// The landing page's hero: Starlight's, with a workspace's disk to work under it and the
// project's name above the title. The title's second sentence - what Spinbox does, after what it
// is - is in the accent: one color, flat, as the console sets what matters.
import { LinkButton } from '@astrojs/starlight/components';
import Disk from './Disk.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const cut = title.indexOf('. ');
const lead = cut < 0 ? title : title.slice(0, cut + 1);
const rest = cut < 0 ? '' : title.slice(cut + 2);
---

<div class="hero">
	<div class="backdrop" aria-hidden="true"></div>
	<div class="copy">
		<p class="eyebrow"><span class="dot"></span>spin-stack · self-hosted sandboxes</p>
		<h1 id="_top" data-page-title>{lead} {rest && <span class="hl">{rest}</span>}</h1>
		{tagline && <p class="tagline" set:html={tagline} />}
		<div class="actions">
			{
				actions.map(({ link: href, text, variant, icon }) => (
					<LinkButton {href} {variant} icon={icon?.name}>
						{text}
					</LinkButton>
				))
			}
		</div>
	</div>
	<div class="art"><Disk /></div>
</div>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		display: grid;
		gap: 2rem;
		align-items: center;
		padding-block: 2rem 1rem;
	}
	/* A grid of dots behind the hero, fading out towards the edges: a drawing board, not a glow. */
	.backdrop {
		position: absolute;
		inset: -10rem calc(50% - 50vw) -6rem;
		z-index: -1;
		pointer-events: none;
		background-image: radial-gradient(color-mix(in srgb, var(--sl-color-gray-3) 38%, transparent) 1px, transparent 1.5px);
		background-size: 22px 22px;
		mask-image: radial-gradient(60% 60% at 60% 45%, #000 20%, transparent 75%);
	}
	.copy {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}
	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
		color: var(--spin-label);
		letter-spacing: 0.04em;
	}
	.dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--spin-label);
	}
	h1 {
		font-family: var(--sl-font-mono);
		font-size: clamp(2.3rem, 1rem + 3.6vw, 3.9rem);
		line-height: 1.08;
		letter-spacing: var(--spin-heading-tracking);
		font-weight: 600;
		color: var(--sl-color-white);
		margin: 0;
	}
	.hl {
		color: var(--spin-accent-text);
	}
	.tagline {
		font-size: var(--sl-text-lg);
		color: var(--sl-color-gray-2);
		max-width: 38rem;
		margin: 0;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.5rem;
		align-items: center;
	}
	/* The disk is the hero's second half, the width of the page under the words: a thing to work,
	   not a picture beside them. */
	.art {
		margin-top: 1rem;
	}
	@media (min-width: 56rem) {
		.hero {
			padding-block: 3.5rem 2rem;
		}
		.copy {
			max-width: 52rem;
		}
	}
	@media (prefers-reduced-motion: no-preference) {
		.copy > * {
			animation: hero-rise var(--spin-duration-draw) var(--spin-ease) both;
		}
		.copy > :nth-child(2) {
			animation-delay: 80ms;
		}
		.copy > :nth-child(3) {
			animation-delay: 160ms;
		}
		.copy > :nth-child(4) {
			animation-delay: 240ms;
		}
		@keyframes hero-rise {
			from {
				opacity: 0;
				transform: translateY(14px);
			}
		}
	}
</style>
