---
// The landing page's capabilities, as a grid of cards (BentoCard.astro).
---

<div class="bento not-content"><slot /></div>

<style>
	.bento {
		display: grid;
		gap: 1rem;
		grid-template-columns: 1fr;
		margin-block: 1.5rem;
	}
	@media (min-width: 50rem) {
		.bento {
			grid-template-columns: repeat(4, 1fr);
			grid-auto-rows: minmax(11rem, auto);
		}
	}
</style>
