---
// The landing page's centrepiece: four steps on the left, a terminal on the right that types each
// step's commands and prints what the diff printed (src/lib/story.ts). It plays by itself once it
// is in view and a step can be picked; without scripts it is the whole session at once, and with
// reduced motion asked for a step is shown whole rather than typed.
import { steps, stepHref, stepOutput } from '../lib/story';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = steps.flatMap((s) => s.commands).join('\n');

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// A command, coloured as a shell would: the program, its flags, a quoted argument, a placeholder.
function command(cmd: string): string {
	return cmd
		.split(/('[^']*'|<[^>]+>|\s+)/)
		.filter(Boolean)
		.map((t, i) => {
			const k = i === 0 ? 'prog' : t.startsWith("'") ? 'str' : t.startsWith('<') ? 'ph' : t.startsWith('--') ? 'flag' : '';
			return k ? `<span class="${k}">${esc(t)}</span>` : esc(t);
		})
		.join('');
}
// The screen as one string: inside a <pre>, the whitespace a template puts between elements
// would be on the screen.
const screen = steps
	.map(
		(s, i) =>
			`<span class="chunk" data-chunk="${i}">` +
			s.commands.map((c) => `<span class="line cmd"><span class="prompt">$ </span><span class="typed">${command(c)}</span>\n</span>`).join('') +
			stepOutput(s)
				.map((o) => {
					// A line of the diff starts with its kind: Added, Modified, Deleted.
					const m = o.match(/^(\s*)([AMD])(\s.*)$/);
					const text = m ? `${esc(m[1])}<span class="kind">${m[2]}</span>${esc(m[3])}` : esc(o);
					return `<span class="line out" data-change="${m ? m[2] : ''}">${text}\n</span>`;
				})
				.join('') +
			'</span>',
	)
	.join('');
const plain = esc(steps.map((s) => [...s.commands.map((c) => `$ ${c}`), ...stepOutput(s)].join('\n')).join('\n\n'));
---

<section class="story not-content" data-story>
	<ol class="steps">
		{
			steps.map((s, i) => (
				<li>
					<button type="button" class="step" data-step={i} aria-pressed={i === 0 ? 'true' : 'false'}>
						<span class="num">0{i + 1}</span>
						<span class="text">
							<span class="label">{s.label}</span>
							<span class="title">{s.title}</span>
							<span class="claim">{s.claim}</span>
						</span>
						<span class="bar" aria-hidden="true" />
					</button>
					<a class="proof" href={`${base}${stepHref(s)}`}>
						How we know →
					</a>
				</li>
			))
		}
	</ol>
	<div class="term spin-dark">
		<div class="chrome">
			<span class="name">demo — spin</span>
			<button type="button" class="ctl" data-skip hidden>Skip</button>
			<button type="button" class="ctl" data-replay hidden>Replay</button>
			<button type="button" class="ctl" data-copy={all}>Copy commands</button>
		</div>
		<pre class="screen" tabindex="0" aria-label="The commands and what the diff printed" set:html={screen + '<span class="caret" aria-hidden="true"></span>'} />
	</div>
	<!-- What the terminal types, whole, for a screen reader: the typed one is half written for most
	     of a minute. -->
	<pre class="sr-only" set:html={plain} />
</section>

<script>
	const CHAR_MS = 22;
	const OUT_MS = 110;
	const HOLD_MS = 2600;
	const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

	for (const root of document.querySelectorAll<HTMLElement>('[data-story]')) {
		const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const buttons = [...root.querySelectorAll<HTMLButtonElement>('.step')];
		const chunks = [...root.querySelectorAll<HTMLElement>('.chunk')];
		const screen = root.querySelector<HTMLElement>('.screen')!;
		// Each typed command's characters, wrapped so a count of them can be shown.
		for (const typed of root.querySelectorAll<HTMLElement>('.typed')) {
			const walker = document.createTreeWalker(typed, NodeFilter.SHOW_TEXT);
			const texts: Text[] = [];
			while (walker.nextNode()) texts.push(walker.currentNode as Text);
			for (const t of texts) {
				const frag = document.createDocumentFragment();
				for (const ch of t.data) {
					const c = document.createElement('span');
					c.className = 'ch';
					c.textContent = ch;
					frag.append(c);
				}
				t.replaceWith(frag);
			}
		}
		const skip = root.querySelector<HTMLButtonElement>('[data-skip]')!;
		const replay = root.querySelector<HTMLButtonElement>('[data-replay]')!;
		let run = 0;

		const select = (i: number) =>
			buttons.forEach((b, j) => {
				b.setAttribute('aria-pressed', String(i === j));
				b.classList.toggle('done', j < i);
			});
		const show = (el: Element) => el.classList.add('on');
		const reset = (el: Element) => el.classList.remove('on');
		const stopBars = () => buttons.forEach((x) => x.querySelector('.bar')?.classList.remove('fill'));
		// The session whole and still: where a play ends, what Skip and reduced motion show, and
		// the only state the screen is read in (the typed one is the sr-only copy's).
		function whole() {
			run++;
			stopBars();
			select(chunks.length - 1);
			root.querySelectorAll('.line, .ch').forEach(show);
			screen.removeAttribute('aria-hidden');
			screen.tabIndex = 0;
			screen.scrollTop = screen.scrollHeight;
			skip.hidden = true;
			replay.hidden = false;
		}

		// It plays once, from the step asked for to the last, and stops on the whole session:
		// nothing on the page moves on its own for longer than that (WCAG 2.2.2), and Skip ends it.
		async function play(i: number, id: number) {
			screen.setAttribute('aria-hidden', 'true');
			screen.removeAttribute('tabindex');
			skip.hidden = false;
			replay.hidden = true;
			select(i);
			chunks.forEach((c, j) => {
				const lines = c.querySelectorAll('.line, .ch');
				if (j < i) lines.forEach(show);
				else lines.forEach(reset);
			});
			const chunk = chunks[i];
			const bar = buttons[i].querySelector<HTMLElement>('.bar')!;
			for (const line of chunk.querySelectorAll<HTMLElement>('.line')) {
				if (id !== run) return;
				show(line);
				screen.scrollTop = screen.scrollHeight;
				if (line.classList.contains('cmd')) {
					for (const ch of line.querySelectorAll('.ch')) {
						if (id !== run) return;
						show(ch);
						await sleep(CHAR_MS);
					}
					await sleep(280);
				} else await sleep(OUT_MS);
			}
			screen.scrollTop = screen.scrollHeight;
			if (i === chunks.length - 1) {
				if (id === run) whole();
				return;
			}
			bar.style.transitionDuration = `${HOLD_MS}ms`;
			bar.classList.add('fill');
			await sleep(HOLD_MS);
			bar.style.transitionDuration = '0ms';
			bar.classList.remove('fill');
			if (id === run) play(i + 1, id);
		}

		const begin = (i: number) => {
			run++;
			stopBars();
			if (still) whole();
			else play(i, run);
		};
		buttons.forEach((b, i) => b.addEventListener('click', () => begin(i)));
		skip.addEventListener('click', () => {
			whole();
			replay.focus();
		});
		replay.addEventListener('click', () => {
			begin(0);
			skip.focus();
		});
		root.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async (e) => {
			const b = e.currentTarget as HTMLButtonElement;
			const said = await navigator.clipboard.writeText(b.dataset.copy ?? '').then(
				() => 'Copied',
				() => 'Select and copy',
			);
			b.textContent = said;
			setTimeout(() => (b.textContent = 'Copy commands'), 1600);
		});
		root.classList.add('armed');
		if (still) {
			whole();
			continue;
		}
		select(0);
		screen.setAttribute('aria-hidden', 'true');
		screen.removeAttribute('tabindex');
		skip.hidden = false;
		const start = new IntersectionObserver(
			(entries) => {
				if (!entries.some((e) => e.isIntersecting)) return;
				start.disconnect();
				begin(0);
			},
			{ threshold: 0.3 },
		);
		start.observe(root);
	}
</script>

<style>
	.story {
		display: grid;
		gap: 2rem;
		align-items: start;
		margin-block: 1rem;
	}
	/* On a narrow screen the terminal comes first, so what is typed is on screen with the steps. */
	.term {
		order: -1;
	}
	@media (min-width: 60rem) {
		.story {
			grid-template-columns: 5fr 7fr;
			gap: 3rem;
		}
		.term {
			order: 0;
		}
	}
	.steps {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.5rem;
	}
	.steps li {
		position: relative;
		margin: 0;
	}
	/* Every step's claim is always there: the one being played is marked, not the only one shown,
	   so the list keeps its height while the terminal plays. */
	.step {
		all: unset;
		box-sizing: border-box;
		position: relative;
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 1rem;
		width: 100%;
		min-height: var(--spin-target-touch);
		padding: 1rem 1.1rem 1.1rem;
		border-radius: var(--spin-radius);
		border: 1px solid transparent;
		cursor: pointer;
		overflow: hidden;
		transition:
			background var(--spin-duration) var(--spin-ease),
			border-color var(--spin-duration) var(--spin-ease);
	}
	.step:hover {
		background: var(--spin-accent-hover);
	}
	.step:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.step[aria-pressed='true'] {
		background: var(--spin-surface);
		border-color: var(--spin-border-strong);
	}
	.num {
		font-family: var(--sl-font-mono);
		font-size: 0.875rem;
		color: var(--spin-muted);
		padding-top: 0.15rem;
		transition: color var(--spin-duration) var(--spin-ease);
	}
	.step[aria-pressed='true'] .num,
	.step.done .num {
		color: var(--spin-label);
	}
	.text {
		display: grid;
		gap: 0.2rem;
	}
	.label {
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--spin-muted);
	}
	.title {
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--sl-color-white);
		padding-right: 6.5rem;
	}
	.claim {
		color: var(--spin-muted);
		font-size: var(--sl-text-sm);
	}
	.bar {
		position: absolute;
		left: 0;
		bottom: 0;
		height: 2px;
		width: 0;
		background: var(--spin-accent);
		transition-property: width;
		transition-timing-function: linear;
	}
	.bar.fill {
		width: 100%;
	}
	.proof {
		position: absolute;
		right: 1.1rem;
		top: 0.75rem;
		display: inline-flex;
		align-items: center;
		min-height: var(--spin-target);
		font-size: 0.75rem;
		font-family: var(--sl-font-mono);
		color: var(--spin-accent-text);
	}
	.proof:hover {
		color: var(--sl-color-white);
	}

	/* The terminal: the brand's dark roles in either theme (.spin-dark), its edge lit in the mark's
	   colours. */
	.term {
		position: relative;
		border-radius: var(--spin-radius-lg);
		background: var(--spin-page);
		border: 1px solid var(--spin-border);
		box-shadow: 0 30px 80px -30px color-mix(in srgb, var(--spin-brand-blue) 60%, transparent);
		overflow: hidden;
		color-scheme: dark;
	}
	.term::before {
		content: '';
		position: absolute;
		inset: -1px;
		border-radius: inherit;
		padding: 1px;
		background: linear-gradient(140deg, var(--spin-brand-cyan), transparent 35%, transparent 65%, var(--spin-brand-blue));
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;
		pointer-events: none;
	}
	.chrome {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.75rem 0.5rem 1rem;
		border-bottom: 1px solid var(--spin-border);
		background: var(--spin-surface);
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
		color: var(--spin-muted);
	}
	.name {
		flex: 1;
	}
	.ctl {
		all: unset;
		box-sizing: border-box;
		min-height: var(--spin-target);
		cursor: pointer;
		padding: 0.25rem 0.6rem;
		border-radius: var(--spin-radius-sm);
		border: 1px solid var(--spin-border);
		color: var(--spin-text);
		transition: border-color var(--spin-duration-fast) var(--spin-ease);
	}
	.ctl[hidden] {
		display: none;
	}
	.ctl:hover {
		border-color: var(--spin-accent);
	}
	.ctl:focus-visible {
		outline: 2px solid var(--spin-accent);
		outline-offset: 1px;
	}
	@media (pointer: coarse) {
		.ctl {
			min-height: var(--spin-target-touch);
		}
	}
	/* A fixed height, so the page under it stays put while it types; the end scrolls into view. */
	.screen {
		margin: 0;
		padding: 1.1rem 1.25rem 1.4rem;
		height: 24rem;
		overflow: auto;
		font-family: var(--sl-font-mono);
		font-size: 0.875rem;
		line-height: 1.75;
		color: var(--spin-text);
		background: var(--spin-page);
		white-space: pre-wrap;
		word-break: break-word;
	}
	.screen:focus-visible {
		outline: 2px solid var(--spin-accent);
		outline-offset: -2px;
	}
	.screen :global(.prompt) {
		color: var(--spin-muted);
		user-select: none;
	}
	.screen :global(.prog) {
		color: var(--spin-accent);
		font-weight: 500;
	}
	/* A flag wraps whole: a hyphen is a break, and a phone split --wait after its first dash. */
	.screen :global(.flag) {
		color: var(--spin-label);
		white-space: nowrap;
	}
	.screen :global(.str) {
		color: var(--spin-warning);
	}
	.screen :global(.ph) {
		color: var(--spin-muted);
		font-style: italic;
	}
	.screen :global(.out) {
		color: var(--spin-text);
	}
	/* A change's kind in the colour of what it did to the file, and its letter, so it reads
	   without the colour: added, modified, deleted. */
	.screen :global(.out[data-change] .kind) {
		font-weight: 600;
	}
	.screen :global(.out[data-change='A'] .kind) {
		color: var(--spin-success);
	}
	.screen :global(.out[data-change='M'] .kind) {
		color: var(--spin-warning);
	}
	.screen :global(.out[data-change='D'] .kind) {
		color: var(--spin-error);
	}
	.screen :global(.chunk + .chunk)::before {
		content: '\A';
	}
	.screen :global(.caret) {
		display: none;
	}

	/* Armed by the script: nothing is on the screen until it is typed. */
	.armed :global(.line),
	.armed :global(.ch) {
		display: none;
	}
	.armed :global(.line.on) {
		display: inline;
	}
	.armed :global(.ch.on) {
		display: inline;
	}
	.armed :global(.chunk + .chunk)::before {
		content: none;
	}
	.armed :global(.caret) {
		display: inline-block;
		width: 0.55em;
		height: 1.1em;
		vertical-align: text-bottom;
		background: var(--spin-label);
	}
</style>
